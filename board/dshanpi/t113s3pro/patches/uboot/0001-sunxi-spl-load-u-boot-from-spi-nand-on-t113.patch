From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DshanPi SDK <sdk@dshanpi.com>
Date: Sat, 22 Aug 2026 00:20:00 -0400
Subject: [PATCH] sunxi: spl: load U-Boot from SPI NAND on T113

The T113 Boot ROM can load an eGON SPL from SPI NAND, but the sunxi SPL
loader only implements the linear 03h read used by SPI NOR. Add the minimal
W25N02 page-to-cache sequence and scan the redundant U-Boot slots.

Signed-off-by: DshanPi SDK <sdk@dshanpi.com>
---
 arch/arm/mach-sunxi/spl_spi_sunxi.c | 96 +++++++++++++++++++++++++++--
 1 file changed, 94 insertions(+), 2 deletions(-)

diff --git a/arch/arm/mach-sunxi/spl_spi_sunxi.c b/arch/arm/mach-sunxi/spl_spi_sunxi.c
--- a/arch/arm/mach-sunxi/spl_spi_sunxi.c
+++ b/arch/arm/mach-sunxi/spl_spi_sunxi.c
@@ -283,6 +283,76 @@ static void spi0_deinit(void)
 
 #define SPI_READ_MAX_SIZE 60 /* FIFO size, minus 4 bytes of the header */
 
+#define SPINAND_PAGE_SIZE 2048
+#define SPINAND_STATUS_BUSY BIT(0)
+
+/*
+ * T113 boards can boot from SPI NAND on SPI0.  Unlike SPI NOR, NAND needs a
+ * page-to-cache command before data can be read from the cache.  Keep this
+ * tiny and controller-specific so it remains suitable for SPL.
+ */
+static void sunxi_spi0_spinand_xfer(const u8 *tx, u32 txlen,
+				    u8 *rx, u32 rxlen)
+{
+	uintptr_t base = spi0_base_address();
+	u32 total = txlen + rxlen;
+	u32 i;
+
+	writel(total, base + SUN6I_SPI0_MBC);
+	writel(txlen, base + SUN6I_SPI0_MTC);
+	writel(txlen, base + SUN6I_SPI0_BCC);
+
+	for (i = 0; i < txlen; i++)
+		writeb(tx[i], base + SUN6I_SPI0_TXD);
+
+	setbits_le32(base + SUN6I_SPI0_TCR, SUN6I_TCR_XCH);
+	while ((readl(base + SUN6I_SPI0_FIFO_STA) & 0x7f) < total)
+		;
+
+	for (i = 0; i < txlen; i++)
+		readb(base + SUN6I_SPI0_RXD);
+	for (i = 0; i < rxlen; i++)
+		rx[i] = readb(base + SUN6I_SPI0_RXD);
+
+	udelay(1);
+}
+
+static void sunxi_spi0_spinand_load_page(u32 page)
+{
+	u8 cmd[4] = { 0x13, page >> 16, page >> 8, page };
+	u8 get_status[2] = { 0x0f, 0xc0 };
+	u8 status;
+
+	sunxi_spi0_spinand_xfer(cmd, sizeof(cmd), NULL, 0);
+	do {
+		sunxi_spi0_spinand_xfer(get_status, sizeof(get_status),
+					  &status, 1);
+	} while (status & SPINAND_STATUS_BUSY);
+}
+
+static void sunxi_spi0_spinand_read_data(u8 *buf, u32 addr, u32 len)
+{
+	u32 cached_page = ~0U;
+
+	while (len) {
+		u32 page = addr / SPINAND_PAGE_SIZE;
+		u32 column = addr % SPINAND_PAGE_SIZE;
+		u32 chunk = min_t(u32, len, SPINAND_PAGE_SIZE - column);
+		u8 cmd[4] = { 0x03, column >> 8, column, 0 };
+
+		chunk = min_t(u32, chunk, SPI_READ_MAX_SIZE);
+		if (page != cached_page) {
+			sunxi_spi0_spinand_load_page(page);
+			cached_page = page;
+		}
+
+		sunxi_spi0_spinand_xfer(cmd, sizeof(cmd), buf, chunk);
+		addr += chunk;
+		buf += chunk;
+		len -= chunk;
+	}
+}
+
 static void sunxi_spi0_read_data(u8 *buf, u32 addr, u32 bufsize,
 				 ulong spi_ctl_reg,
 				 ulong spi_ctl_xch_bitmask,
@@ -328,6 +398,11 @@ static void spi0_read_data(void *buf, u32 addr, u32 len)
 	u32 chunk_len;
 	uintptr_t base = spi0_base_address();
 
+	if (IS_ENABLED(CONFIG_MACH_SUN8I_R528)) {
+		sunxi_spi0_spinand_read_data(buf8, addr, len);
+		return;
+	}
+
 	while (len > 0) {
 		chunk_len = len;
 		if (chunk_len > SPI_READ_MAX_SIZE)
@@ -383,7 +458,20 @@ static int spl_spi_load_image(struct spl_image_info *spl_image,
 
 	spi0_init();
 
-	spi0_read_data((void *)header, load_offset, 0x40);
+	if (IS_ENABLED(CONFIG_MACH_SUN8I_R528)) {
+		for (; load_offset < 0x400000; load_offset += 0x100000) {
+			spi0_read_data((void *)header, load_offset, 0x40);
+			if (image_get_magic(header) == IH_MAGIC ||
+			    image_get_magic(header) == FDT_MAGIC)
+				break;
+		}
+		if (load_offset == 0x400000) {
+			ret = -ENODEV;
+			goto out;
+		}
+	} else {
+		spi0_read_data((void *)header, load_offset, 0x40);
+	}
 
         if (IS_ENABLED(CONFIG_SPL_LOAD_FIT) &&
 		image_get_magic(header) == FDT_MAGIC) {
@@ -396,15 +484,20 @@ static int spl_spi_load_image(struct spl_image_info *spl_image,
 	} else {
 		ret = spl_parse_image_header(spl_image, bootdev, header);
 		if (ret)
-			return ret;
+			goto out;
 
 		spi0_read_data((void *)spl_image->load_addr,
 			       load_offset, spl_image->size);
 	}
 
+out:
 	spi0_deinit();
 
 	return ret;
 }
 /* Use priorty 0 to override the default if it happens to be linked in */
 SPL_LOAD_IMAGE_METHOD("sunxi SPI", 0, BOOT_DEVICE_SPI, spl_spi_load_image);
+#if defined(CONFIG_MACH_SUN8I_R528)
+SPL_LOAD_IMAGE_METHOD("sunxi SPI NAND", 0, BOOT_DEVICE_NAND,
+		      spl_spi_load_image);
+#endif
-- 
2.43.0

