CONFIG_SPL_SPI_SUNXI=y
CONFIG_SPL_SPI_NAND_SUNXI=y
CONFIG_SPL_FEL_RETURN_DIAGNOSTIC=y
CONFIG_SPL_STACK=0x37ff0
CONFIG_SYS_SPI_U_BOOT_OFFS=0x100000
CONFIG_MTD=y
CONFIG_DM_MTD=y
CONFIG_DM_SPI=y
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_SUNXI=y
CONFIG_MTD_SPI_NAND=y
CONFIG_CMD_MTD=y
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y
# CONFIG_ANDROID_BOOT_IMAGE is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="earlycon=uart8250,mmio32,0x02500c00 console=ttyS3,115200 ignore_loglevel loglevel=8 clk_ignore_unused ubi.mtd=sys root=ubi0:rootfs rootfstype=ubifs rw rootwait"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then echo Mainline FEL installer; bootm 0x44000000; else mtd list; mtd read boot 0x44000000; bootm 0x44000000; fi"
CONFIG_BOOTDELAY=3
CONFIG_IDENT_STRING=" DshanPi T113S3 Pro"

